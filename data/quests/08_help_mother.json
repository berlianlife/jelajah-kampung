          ],
          "choices": [
            {
              "label": "Diam saja, pura-pura tidak dengar",
              "reply": [
                {
                  "who": "Ibu",
                  "text": "Kalau diam, Ibu jadi sedih. Coba pikirkan jawaban yang lebih baik, lalu bicara lagi dengan Ibu."
                }
              ]
            },
            {
              "label": "\"Iya, Bu. Ahmad segera ke sana.\"",
              "set_state": 2,
              "add_sticker": 1,
              "sfx": "done",
              "learn": "adab.orang_tua",
              "learn_title": "Berbakti kepada Orang Tua",
              "learn_text": "Ahmad membantu Ibu merapikan kamar dan menjawab panggilan Ibu dengan sopan. Membantu dan berkata lembut kepada orang tua termasuk berbakti.",
              "reply": [
                {
                  "who": "Ibu",
                  "text": "Jawaban yang sopan. Ibu senang punya anak seperti Ahmad."
                }
              ]
            },
            {
              "label": "\"Nanti saja, Bu!\"",
              "reply": [
                {
                  "who": "Ibu",
                  "text": "Hmm, jawaban itu kurang sopan. Coba pikirkan lagi, lalu bicara lagi dengan Ibu."
                }
              ]
            }
          ]
        }
      ],
